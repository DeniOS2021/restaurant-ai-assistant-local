# Nur Namen der Variablen / variable names only – keine Werte committen.
# Lokale Dienste (im JSON als YOUR_LOCAL_HOST:<port>)
LOCAL_HOST=                 # Rechner mit LM Studio, Qdrant, Sprachdienst (z. B. per VPN erreichbar)
LMSTUDIO_PORT=1234          # OpenAI-kompatible API (Router-LoRA, Agenten, Judge)
QDRANT_PORT=6333
VOICE_SERVICE_PORT=8088     # whisper.cpp (STT) + Piper (TTS) hinter einem kleinen HTTP-Dienst
VOICE_SERVICE_TOKEN=        # Header-Auth für den Sprachdienst
QDRANT_API_KEY=
# Datenbank
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DB=basilik
POSTGRES_USER=
POSTGRES_PASSWORD=
# Kanäle
TELEGRAM_BOT_TOKEN=
WHATSAPP_CLOUD_TOKEN=
TELEGRAM_OPERATOR_CHAT_ID=  # im JSON: YOUR_CHAT_ID
# Öffentliche n8n-Adresse (im JSON: your-n8n.example.com)
N8N_PUBLIC_URL=
